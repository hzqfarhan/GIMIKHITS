# Leave empty until the event domain is ready. Four hosts point to one deployment:
# hitsmainpanel.seladevs.my, qr.seladevs.my, bypass.seladevs.my, audience.seladevs.my
# Set EVENT_BASE_DOMAIN=seladevs.my once the four domains are connected.
EVENT_BASE_DOMAIN=
# Set a strong private value in production. Local rehearsal reuses ignored .dev.vars.
ORGANISER_KEY=
# Supabase: server-only credentials, never NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy service_role JWT can be used instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional persistent SQLite file location for the Next.js Node server.
# EVENT_DB_PATH=/persistent/event.sqlite
